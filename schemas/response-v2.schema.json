{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samrigo/q-mentor/blob/Claude-v2/schemas/response-v2.schema.json",
  "title": "qmentor.response.v2 (machine mode)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "mode", "result", "assumptions", "evidence", "validation", "skills_used", "next_action"],
  "properties": {
    "contract_version": {"const": "qmentor.response.v2"},
    "status": {"enum": ["complete", "needs-input", "blocked", "unsupported", "unverified"]},
    "mode": {"const": "machine"},
    "result": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source", "source_type"],
        "properties": {
          "claim": {"type": "string"},
          "source": {"type": "string"},
          "source_type": {"enum": ["peer-reviewed", "preprint", "vendor-documentation", "vendor-result", "secondary", "repository-artifact", "local-computation"]},
          "label": {"enum": ["fact", "assumption", "estimate", "unknown"]}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checks"],
      "properties": {
        "state": {"enum": ["not-run", "draft", "syntax-checked", "imported", "locally-executed", "target-validated", "unverified"]},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "skills_used": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^q-mentor-[a-z-]+$"}
    },
    "next_action": {"type": "string", "minLength": 1}
  }
}
