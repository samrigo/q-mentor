{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samrigo/q-mentor/blob/Claude-v3/schemas/skill-registry.schema.json",
  "title": "qmentor.skill-registry.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plugin_version", "response_contract", "max_skills_per_turn", "max_chain_depth", "user_supplied_artifacts", "skills"],
  "properties": {
    "contract_version": {"const": "qmentor.skill-registry.v3"},
    "plugin_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "response_contract": {"const": "qmentor.response.v3"},
    "max_skills_per_turn": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_chain_depth": {"type": "integer", "minimum": 1, "maximum": 5},
    "user_supplied_artifacts": {"type": "array", "items": {"type": "string"}},
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "user_invocable", "template_id", "summary", "use_when", "example", "output", "intents", "requires", "produces", "prerequisites", "follow_ons", "side_effects", "tools", "packs"],
        "properties": {
          "name": {"type": "string", "pattern": "^q-mentor-[a-z-]+$", "maxLength": 64},
          "user_invocable": {"type": "boolean"},
          "template_id": {"enum": [null, "guide", "options", "evidence", "frame", "decision", "design", "mapping", "evaluation", "conversion", "code", "review", "improvement"]},
          "summary": {"type": "string", "minLength": 10, "maxLength": 140},
          "use_when": {"type": "string", "minLength": 10, "maxLength": 160},
          "example": {"type": "string", "minLength": 5, "maxLength": 120},
          "output": {"type": "string", "minLength": 3, "maxLength": 80},
          "intents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requires": {"type": "array", "items": {"type": "string"}},
          "requires_any": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "follow_ons": {"type": "array", "items": {"type": "string"}},
          "side_effects": {"enum": ["none", "edit", "execute"]},
          "tools": {"type": "array", "items": {"enum": ["read", "search", "edit", "execute", "web"]}},
          "packs": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"user_invocable": {"const": true}}}, "then": {"properties": {"template_id": {"type": "string"}}}},
          {"if": {"properties": {"user_invocable": {"const": false}}}, "then": {"properties": {"template_id": {"const": null}}}}
        ]
      }
    }
  }
}
