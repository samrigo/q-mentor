{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samrigo/q-mentor/blob/Claude-v2/schemas/capability-report.schema.json",
  "title": "qmentor.capability-report.v2",
  "type": "object",
  "required": ["schema", "problem_id", "target", "status", "checks", "lost_semantics", "alternatives"],
  "properties": {
    "schema": {"const": "qmentor.capability-report.v2"},
    "status": {"enum": ["exact", "approximate", "unsupported-exact", "unknown"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check", "required", "observed", "pass"]}},
    "lost_semantics": {"type": "array", "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "exact"}}}, "then": {"properties": {"lost_semantics": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "unsupported-exact"}}}, "then": {"properties": {"alternatives": {"minItems": 1}}}}
  ]
}
