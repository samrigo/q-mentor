{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samrigo/q-mentor/blob/Claude-v3/schemas/response-v3.schema.json",
  "title": "qmentor.response.v3 (machine mode and internal ResponseEnvelope)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "status", "mode", "template_id", "audience", "result", "evidence", "uncertainty", "validation", "artifacts", "skills_used", "next_action"],
  "properties": {
    "contract_version": {"const": "qmentor.response.v3"},
    "status": {"enum": ["complete", "needs-input", "blocked", "unsupported", "unverified"]},
    "mode": {"enum": ["machine", "brief", "detailed", "code-only", "custom"]},
    "template_id": {"enum": ["guide", "options", "evidence", "frame", "decision", "design", "mapping", "evaluation", "conversion", "code", "review", "improvement"]},
    "audience": {"enum": ["business", "technical"]},
    "result": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "detail"],
      "properties": {
        "state": {"enum": ["not-applicable", "not-run", "draft", "syntax-checked", "imported", "locally-executed", "target-validated", "unverified", "failed"]},
        "detail": {"type": "string"}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "skills_used": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^q-mentor-[a-z-]+$"}
    },
    "next_action": {"type": "string", "minLength": 1}
  }
}
